{
  "name": "stats-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "ts-node prisma/seed.ts",
    "bench:seed": "tsx scripts/bench/seed.ts",
    "bench": "tsx scripts/bench/measure.ts",
    "bench:baseline": "tsx scripts/bench/measure.ts --baseline",
    "bench:compare": "tsx scripts/bench/measure.ts --compare scripts/bench/before.json scripts/bench/after.json",
    "migrate": "node migrations/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@libsql/client": "^0.17.4",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
